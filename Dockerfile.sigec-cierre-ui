# Stage 1: Build
FROM node:20-alpine AS build
WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY package*.json ./
RUN npm ci

COPY . .

# Compilar la aplicación sigec-cierre con el perfil de Calidad (Quality)
RUN npx nx build sigec-cierre --configuration=quality

# Stage 2: Servidor Web de Producción (Nginx)
FROM nginx:stable-alpine
COPY --from=build /app/dist/apps/sigec-cierre/browser /usr/share/nginx/html

# environment.quality.ts usa rutas relativas: este Nginx las reenvía a la API de Cierre
# (red interna de Docker) y a test.agroideas.gob.pe, de modo que el navegador solo
# habla con su propio origen y no depende del CORS de ninguna API.
COPY <<-'EOF' /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name localhost;

    # PDF de hasta 10 MB (environment.archivos) más el resto del formulario multipart
    client_max_body_size 50m;

    location /api/v1/ {
        proxy_pass http://sigec-cierre-api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 120s;
    }

    location /api-seguridad/ {
        proxy_pass https://test.agroideas.gob.pe/api-seguridad/;
        proxy_ssl_server_name on;
        proxy_set_header Host test.agroideas.gob.pe;
    }

    # Búsqueda de convenios al iniciar un expediente (ADR 0014, Fase 1)
    location /api-general/ {
        proxy_pass https://test.agroideas.gob.pe/api-general/;
        proxy_ssl_server_name on;
        proxy_set_header Host test.agroideas.gob.pe;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
EOF

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
