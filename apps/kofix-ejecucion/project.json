{
  "name": "kofix-ejecucion",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/kofix-ejecucion/src",
  "tags": [
    "scope:kofix",
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/kofix-ejecucion",
        "index": "apps/kofix-ejecucion/src/index.html",
        "browser": "apps/kofix-ejecucion/src/main.ts",
        "polyfills": [
          "zone.js",
          "@angular/localize/init"
        ],
        "tsConfig": "apps/kofix-ejecucion/tsconfig.app.json",
        "inlineStyleLanguage": "css",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/kofix-ejecucion/public"
          }
        ],
        "styles": [
          "node_modules/leaflet/dist/leaflet.css",
          "apps/kofix-ejecucion/src/styles.css",
          "libs/theme/src/styles/base.css"
        ],
        "scripts": [],
        "allowedCommonJsDependencies": ["sweetalert2", "leaflet"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.5mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "10kb",
              "maximumError": "20kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "port": 7100
      },
      "configurations": {
        "production": {
          "buildTarget": "kofix-ejecucion:build:production"
        },
        "development": {
          "buildTarget": "kofix-ejecucion:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "kofix-ejecucion:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/kofix-ejecucion/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "kofix-ejecucion:build",
        "port": 4200,
        "staticFilePath": "dist/apps/kofix-ejecucion/browser",
        "spa": true
      }
    }
  }
}
