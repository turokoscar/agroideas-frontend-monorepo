{
  "name": "sigec-cierre",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/sigec-cierre/src",
  "tags": ["scope:sigec", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/sigec-cierre",
        "index": "apps/sigec-cierre/src/index.html",
        "browser": "apps/sigec-cierre/src/main.ts",
        "polyfills": ["zone.js", "@angular/localize/init"],
        "tsConfig": "apps/sigec-cierre/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/sigec-cierre/public"
          },
          {
            "glob": "pdf.worker.min.mjs",
            "input": "node_modules/pdfjs-dist/build",
            "output": "/"
          },
          {
            "glob": "**/*",
            "input": "node_modules/pdfjs-dist/cmaps",
            "output": "/cmaps"
          },
          {
            "glob": "**/*",
            "input": "node_modules/pdfjs-dist/standard_fonts",
            "output": "/standard_fonts"
          }
        ],
        "styles": [
          "libs/theme/src/styles/base.css",
          "apps/sigec-cierre/src/styles.scss"
        ],
        "scripts": [],
        "allowedCommonJsDependencies": ["sweetalert2"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "quality": {
          "fileReplacements": [
            {
              "replace": "apps/sigec-cierre/src/environments/environment.ts",
              "with": "apps/sigec-cierre/src/environments/environment.quality.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "sigec-cierre:build:production"
        },
        "development": {
          "buildTarget": "sigec-cierre:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "port": 4400
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "sigec-cierre:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/sigec-cierre/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "sigec-cierre:build",
        "port": 4400,
        "staticFilePath": "dist/apps/sigec-cierre/browser",
        "spa": true
      }
    }
  }
}
