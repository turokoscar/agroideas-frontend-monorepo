# Stage 1: Build
FROM node:20-alpine AS build
WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY package*.json ./
RUN npm ci

COPY . .

# Compilar la aplicación sigec-rtf con el perfil de Calidad (Quality)
RUN npx nx build sigec-rtf --configuration=quality

# Stage 2: Servidor Web de Producción (Nginx)
FROM nginx:stable-alpine
COPY --from=build /app/dist/apps/sigec-rtf/browser /usr/share/nginx/html

# environment.quality.ts usa rutas relativas: este Nginx las reenvía a la API RTF
# (red interna de Docker) y a test.agroideas.gob.pe, de modo que el navegador solo
# habla con su propio origen y no depende del CORS de ninguna API.
COPY <<-'EOF' /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name localhost;

    client_max_body_size 50m;

    location /api/v1/ {
        proxy_pass http://sigec-rtf-api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 120s;
    }

    # API de Cierre de Convenio (Anexo 20 del último RTF; ADR 0013 del monorepo). El nombre se resuelve
    # en cada petición con el DNS de Docker (127.0.0.11): si sigec-cierre-api aún no está desplegado,
    # esta ruta responde 502 pero el resto de la UI de RTF arranca igual.
    location /api-cierre/ {
        resolver 127.0.0.11 valid=30s;
        set $cierre_api http://sigec-cierre-api:8080;
        rewrite ^/api-cierre/(.*)$ /$1 break;
        proxy_pass $cierre_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 120s;
    }

    location /api-seguridad/ {
        proxy_pass https://test.agroideas.gob.pe/api-seguridad/;
        proxy_ssl_server_name on;
        proxy_set_header Host test.agroideas.gob.pe;
    }

    location /api-general/ {
        proxy_pass https://test.agroideas.gob.pe/api-general/;
        proxy_ssl_server_name on;
        proxy_set_header Host test.agroideas.gob.pe;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
EOF

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
